    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "topk, не все серии. Пустая таблица имеет возраст 0 и в топ не попадает. Порог свежести зависит от пайплайна и задаётся не здесь.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
