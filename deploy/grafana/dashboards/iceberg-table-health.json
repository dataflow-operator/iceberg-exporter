          "editorMode": "code",
          "expr": "topk(20, max by (exported_namespace, catalog, ref, namespace, table) (iceberg_table_snapshot_age_seconds{exported_namespace=~\"$exported_namespace\",catalog=~\"$catalog\",ref=~\"$ref\"}))",
