  "schemaVersion": 39,
  "tags": [
    "iceberg"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values({__name__=~\"iceberg_catalog_up|iceberg_table_records\"}, catalog)",
        "hide": 0,
        "includeAll": true,
        "label": "catalog",
        "multi": true,
        "name": "catalog",
        "options": [],
        "query": "label_values({__name__=~\"iceberg_catalog_up|iceberg_table_records\"}, catalog)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "main",
          "value": "main"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values({__name__=~\"iceberg_catalog_ref_head_age_seconds|iceberg_table_records\",catalog=~\"$catalog\"}, ref)",
        "hide": 0,
        "includeAll": true,
        "label": "ref",
        "multi": true,
        "name": "ref",
        "options": [],
        "query": "label_values({__name__=~\"iceberg_catalog_ref_head_age_seconds|iceberg_table_records\",catalog=~\"$catalog\"}, ref)",
