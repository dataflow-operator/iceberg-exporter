      "description": "Только если адаптер заявил MultiRef. Для feature-веток расхождение ожидаемо и не алертится.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
