        "uid": "${datasource}"
      },
      "description": "Один stage с ошибкой считает таблицу один раз. Ошибка одной таблицы не роняет scrape.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
