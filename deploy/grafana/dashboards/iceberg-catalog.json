          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "iceberg_tables{catalog=~\"$catalog\",ref=~\"$ref\"}",
          "instant": false,
          "range": true,
          "refId": "A",
          "legendFormat": "tables {{catalog}} {{ref}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "iceberg_views{catalog=~\"$catalog\",ref=~\"$ref\"}",
